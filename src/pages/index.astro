---
import AppShell from "../components/layout/AppShell.astro";
import { ArchiveSection } from "../components/sections/ArchiveSection";
import { HomeSection } from "../components/sections/HomeSection";
import { IntelSection } from "../components/sections/IntelSection";
import { UplinkSection } from "../components/sections/UplinkSection";
import IdCard from "../components/widgets/IdCard.astro";
import { profile } from "../data/profile";

// Bundled fonts (Latin subsets only: smaller than the default all-languages import)
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-500.css";
import "@fontsource/jetbrains-mono/latin-700.css";
import "@fontsource/press-start-2p/latin-400.css";

// Styles (order matters: tokens → layout → components → motion)
import "../styles/global.css";
import "../styles/layout.css";
import "../styles/components.css";
import "../styles/identity.css";
import "../styles/animations.css";
import "../styles/print.css";

const title = "Dwight Jairo C. Pingul — Backend & Systems Software Engineer";
const description =
  "Portfolio of Dwight Jairo C. Pingul, a backend and systems software engineer working with PHP, Laravel, Node.js, TypeScript and MySQL.";
const pageUrl = new URL(import.meta.env.BASE_URL, Astro.site).href;
const ogImageUrl = new URL(`${import.meta.env.BASE_URL}og-image.png`, Astro.site).href;
// Island props: with a form service configured, the email is deliberately NOT passed, so it
// never reaches the client JavaScript (UplinkSection no longer imports profile.ts).
const uplinkProps = profile.formEndpoint
  ? { formEndpoint: profile.formEndpoint }
  : { email: profile.email };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#05070a" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Terminal window showing Dwight Jairo C. Pingul, backend and systems software engineer"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Before first paint: lets the skill bars start empty and fill on scroll
         (scripts/skillReveal.ts). Without JavaScript the class is never added and
         the bars are simply full. Failsafe: if the reveal script has not started
         within 4s (bundle failed or very slow network), drop the class so the
         skills are never left hidden. -->
    <script is:inline>
      (() => {
        if (!("IntersectionObserver" in window)) return;
        const root = document.documentElement;
        root.classList.add("js-reveal");
        setTimeout(() => {
          if (!root.hasAttribute("data-reveal-ready")) root.classList.remove("js-reveal");
        }, 4000);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <AppShell>
      <HomeSection slot="center">
        <IdCard />
      </HomeSection>
      <ArchiveSection slot="center" />
      <IntelSection slot="center" />
      <UplinkSection slot="center" client:visible {...uplinkProps} />
    </AppShell>

    <script>
      import "../scripts/main";
    </script>
  </body>
</html>
