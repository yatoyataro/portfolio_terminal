---
import AppShell from "../components/layout/AppShell.astro";
import { Button } from "../components/ui/Button";
import { TerminalBox } from "../components/widgets/TerminalBox";

// Styles (order matters: tokens → layout → components → identity → motion → print)
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-500.css";
import "@fontsource/jetbrains-mono/latin-700.css";
import "@fontsource/press-start-2p/latin-400.css";

import "../styles/global.css";
import "../styles/layout.css";
import "../styles/components.css";
import "../styles/identity.css";
import "../styles/animations.css";
import "../styles/print.css";

const homeUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 :: SEGMENTATION_FAULT — Dwight Jairo C. Pingul</title>
    <meta
      name="description"
      content="The requested page could not be found. Return to Dwight Jairo C. Pingul's portfolio."
    />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#05070a" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <AppShell>
      <section slot="center" class="section" aria-labelledby="error-heading">
        <h1 id="error-heading" class="sr-only">Page not found (404)</h1>

        <TerminalBox
          variant="console"
          title="ERROR_404 :: SEGMENTATION_FAULT"
          meta="PID: 404"
          headingLevel={2}
        >
          <p class="crash-line crash-line--accent">{"> ACCESS_VIOLATION: 0x00000040"}</p>
          <p class="crash-line">{"> The requested segment could not be read."}</p>
          <p class="crash-line">
            {">"} This address does not exist, was moved, or was never deployed.
          </p>
          <p class="crash-line crash-line--muted">{"> CORE DUMP: written to /dev/null"}</p>

          <div class="form-actions">
            <Button as="a" variant="primary" href={homeUrl}>
              [ {">"} RETURN_TO_BASE ]
            </Button>
          </div>
        </TerminalBox>
      </section>
    </AppShell>
  </body>
</html>
